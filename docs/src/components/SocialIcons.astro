---
// The header's right group: a link to the documentation before Starlight's own icons.
// The landing page has no sidebar, so this is how it leads into the docs.
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const it = Astro.locals.starlightRoute.locale === "it";
const href = it ? "/it/start/install/" : "/start/install/";
---

<a {href} class="docs-link">{it ? "Documentazione" : "Docs"}</a>
<Default />

<style>
  .docs-link {
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .docs-link:hover {
    color: var(--sl-color-text-accent);
  }
</style>
