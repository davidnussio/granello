{
  "name": "granello",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "dev:secrets": "envsec -c ai run --inject \"pnpm tauri dev\"",
    "test": "cd src-tauri && cargo test",
    "check": "tsc && oxlint --deny-warnings && oxfmt --check && node scripts/check-i18n.mjs && cd src-tauri && cargo clippy --all-targets -- -D warnings && cargo test",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "preview:data": "cd src-tauri && cargo test --lib preview_fixtures -- --ignored --quiet",
    "preview": "pnpm preview:data && vite --port 1430 --strictPort",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.11.0",
    "@tiptap/extension-task-list": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@tiptap/suggestion": "^2.27.3",
    "dompurify": "^3.2.0",
    "katex": "^0.19.1",
    "markdown-it-container": "^4.0.0",
    "marked": "^15.0.0",
    "mermaid": "^12.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.94.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
